SECRET_KEY=change-me-to-a-long-random-string
# Radar AI + voice notes (https://console.groq.com/keys). Without it Radar uses a simple built-in date parser and voice is disabled.
GROQ_API_KEY=
# Photo uploads (Cloudinary dashboard > API Keys > "API environment variable"). Without it photos are saved on local disk.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
